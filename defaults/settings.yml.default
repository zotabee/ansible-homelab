---
group: docker
user: debian
uid: 1000
gid: 998
domain: example.com
data_folder: /mnt/storage
tz: "Europe/Zurich"
actualbudget:
  tag: latest
  folder: /opt/actualbudget
  subdomain: actualbudget
homebox:
  tag: latest
  folder: /opt/homebox
  subdomain: homebox
paperless:
  tag: latest # Or an exact release, quoted, without its "v" (e.g. "3.3.0"); run an export before an upgrade
  folder: /opt/paperless
  subdomain: paperless
  media_folder: "" # The documents (originals, archived PDFs, thumbnails); empty is <folder>/media
  consume_folder: "{{ data_folder }}/paperless/consume" # The inbox Paperless watches, on the data folder so Syncthing or File Browser can drop scans in; Paperless re-owns it at each start
  dbengine: sqlite # sqlite or postgresql, chosen before the first run: switching later needs an export and an import
  tika: false # true adds Tika and Gotenberg, for Office documents and .eml files
  ocr_language: fra+eng # Tesseract codes joined by +; the first one also sets the search and classifier language
  ocr_languages: "" # Extra Tesseract packages, space separated, installed at each start (eng deu fra ita spa ship with the image)
  secret_key: "" # Empty generates one, kept in <folder>/.secrets/secret_key
  user: "" # The admin, made on the first run; empty gives "<first label of domain>.paperless"
  password: "" # Empty generates one, kept in <folder>/.secrets/admin_password
whalevane:
  tag: latest
  folder: /opt/whalevane
  subdomain: whalevane
  send: false # true only at cutover: sends Telegram and starts the watchdog
  ghcr_user: zotabee
  ghcr_token: "" # Classic token with read:packages only; set it in settings.yml
  homer_logo: "" # e.g. assets/homer-icons/svg/<file>.svg; empty shows no logo
  crawl_at: "02:30" # UTC, HH:MM: the daily crawl's start (a container start crawls too, unless a whole crawl is under 6 hours old)
  log_archive_days: 180 # How long the archived container logs in <folder>/logs are kept
  backups_keep: 10 # How many automatic snapshots in <folder>/backups are kept; named ones (before-*, offhost-*) are never removed
  crawl_sources:
    - binance.copytrading
    - binance.smartmoney
    - hyperliquid.perps
    - bybit.copytrading
yamtrack:
  tag: latest
  folder: /opt/yamtrack
  subdomain: yamtrack
  secret: MyYamtrackSecret
  tmdb_api: "" # A default is provided
  trakt_api: ""
  mal_api: "" # A default is provided
  igdb_id: "" # A default is provided
  igdb_secret: "" # A default is provided
  simkl_id: "" # Only needed for importing media from Simkl, a default is provided
  simkl_secret: "" # Only needed for importing media from Simkl, a default is provided
