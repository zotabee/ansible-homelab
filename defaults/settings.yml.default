---
group: docker
user: debian
uid: 1000
gid: 998
domain: example.com
data_folder: /mnt/storage
tz: "Europe/Zurich"
actualbudget:
  tag: latest
  folder: /opt/actualbudget
  subdomain: actualbudget
floppy:
  tag: "26.10.8" # An image tag: a release without its "v". "release" follows each new release; never "latest" (every commit)
  folder: /opt/floppy
  subdomain: floppy
  secret: "" # Django key for sessions, CSRF tokens and the stored credentials; empty generates one, kept in <folder>/.secrets/secret
  user: "" # Admin made on the first run; empty gives "<first label of domain>.floppy"
  password: "" # Empty generates one, kept in <folder>/.secrets/admin_password
  registration: false # The signup form; the admin above is made without it
  tmdb_api: "" # A default is provided
  tvdb_api_key: ""
  mal_api: "" # A default is provided
  igdb_id: "" # Games need both igdb_id and igdb_secret (a Twitch app): the default id alone is not enough
  igdb_secret: ""
  trakt_api: ""
  trakt_api_secret: ""
  simkl_id: "" # No default: Simkl import needs both the id and the secret
  simkl_secret: ""
  hardcover_api: "" # No default: Hardcover book metadata needs your own token
  comicvine_api: "" # A default is provided
  lastfm_api_key: ""
homebox:
  tag: latest
  folder: /opt/homebox
  subdomain: homebox
whalevane:
  tag: latest
  folder: /opt/whalevane
  subdomain: whalevane
  send: false # true only at cutover: sends Telegram and starts the watchdog
  ghcr_user: zotabee
  ghcr_token: "" # Classic token with read:packages only; set it in settings.yml
  homer_logo: "" # e.g. assets/homer-icons/svg/<file>.svg; empty shows no logo
  crawl_at: "02:30" # UTC, HH:MM: the daily crawl's start (a container start crawls too, unless a whole crawl is under 6 hours old)
  log_archive_days: 180 # How long the archived container logs in <folder>/logs are kept
  backups_keep: 10 # How many automatic snapshots in <folder>/backups are kept; named ones (before-*, offhost-*) are never removed
  crawl_sources:
    - binance.copytrading
    - binance.smartmoney
    - hyperliquid.perps
    - bybit.copytrading
